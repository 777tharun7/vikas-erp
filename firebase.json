{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "backend/**",
      "tests/**",
      "*.tar.gz",
      "*.db",
      "*.sh"
    ],
    "rewrites": [
      {
        "source": "/schools/kidhood-nizampet",
        "destination": "/schools/kidhood-nizampet/index.html"
      },
      {
        "source": "!/schools/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=7200"
          }
        ]
      }
    ]
  }
}
