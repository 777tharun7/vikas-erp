# ==========================================
# EDUPULSE MULTI-TENANT BACKEND ENVIRONMENT
# ==========================================

# 1. Google Cloud SQL (PostgreSQL) Connection String
# Option A: Direct TCP (Public IP with Authorized Networks):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_CLOUD_SQL_PUBLIC_IP:5432/edupulse

# Option B: Cloud Run Unix Socket (Recommended for Production):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@/edupulse?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Option C: Local PostgreSQL / Cloud SQL Proxy:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/edupulse

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_CLOUD_SQL_IP:5432/edupulse

# 2. JWT Security
SECRET_KEY=edupulse_production_secret_key_telangana_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. Default School Tenant
DEFAULT_SCHOOL_SLUG=vikas-cherial
